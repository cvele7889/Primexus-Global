# Copy to .env for local dev. Do not commit .env.
VITE_RECAPTCHA_SITE_KEY=
# Public forwarding number in E.164 format (e.g. +381112233445)
VITE_PUBLIC_PHONE=

# Primexus AI chat (optional — works with built-in assistant if unset)
# Groq (free tier) — default provider
VITE_AI_API_KEY=
VITE_AI_API_URL=https://api.groq.com/openai/v1/chat/completions
VITE_AI_MODEL=llama-3.3-70b-versatile
# Option B: custom backend endpoint (POST { language, messages } → { reply })
VITE_AI_CHAT_ENDPOINT=
